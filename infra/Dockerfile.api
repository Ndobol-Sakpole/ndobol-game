FROM node:24-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY services/api ./services/api
COPY shared ./shared
COPY data/migrations ./data/migrations
COPY data/store.js data/supabase-store.js data/validate-round.js ./data/
COPY apps/web/js/world/tracks ./apps/web/js/world/tracks
RUN mkdir -p /app/storage && chown node:node /app/storage
ENV HOST=0.0.0.0 API_PORT=8787 DATABASE_PATH=/app/storage/ndobol.sqlite
USER node
EXPOSE 8787
HEALTHCHECK --interval=5s --timeout=3s CMD node -e "fetch('http://127.0.0.1:8787/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "services/api/server.js"]

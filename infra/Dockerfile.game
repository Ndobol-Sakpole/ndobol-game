FROM node:24-alpine
WORKDIR /app
COPY package.json ./
COPY apps/web ./apps/web
COPY shared ./shared
COPY infra/static-server.js ./infra/static-server.js
ENV HOST=0.0.0.0 WEB_PORT=4174
USER node
EXPOSE 4174
HEALTHCHECK --interval=15s --timeout=3s CMD node -e "fetch('http://127.0.0.1:4174/apps/web/index.html').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "infra/static-server.js"]

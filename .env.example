# Local services. No secrets are read by browser JavaScript.
WEB_PORT=4174
API_PORT=8787
HOST=127.0.0.1
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz
# Fill only in an ignored local environment or a secret store.
DEPLOYER_PRIVATE_KEY=
CONTRACT_OWNER=
ETHERSCAN_API_KEY=
VERIFIER_URL=
NDOBOL_ITEMS_ADDRESS=
RIVER_REGISTRY_ADDRESS=
IMPACT_BADGE_ADDRESS=
# Explicit opt-in for the separately invoked mainnet deployment script.
CONFIRM_MAINNET=0
# Phase 2: never expose these variables through the static server.
DATABASE_PATH=data/ndobol.sqlite
API_ORIGIN=http://127.0.0.1:8787
ALLOWED_ORIGINS=http://127.0.0.1:4174,http://localhost:4174
SIGNER_PRIVATE_KEY=
SIGNING_CHAIN_ID=10143
# RIVER_REGISTRY_ADDRESS above is the future EIP-712 verifier, not a wallet.
# Without a key/verifier, games and persistence work; signing fails closed (503).

# Operator-funded native MON rewards. Leave disabled until deployed and funded.
REWARD_POOL_ADDRESS=
REWARD_SIGNER_ADDRESS=
REWARD_CLAIMS_ENABLED=false

# Game cloud deployment (Supabase is API-only; public web build copies only PUBLIC_API_ORIGIN).
DATA_BACKEND=sqlite
SUPABASE_URL=
# Preferred backend key (sb_secret_...). Never use NEXT_PUBLIC_ for this key.
SUPABASE_SECRET_KEY=
# Optional legacy service_role JWT; used only when SUPABASE_SECRET_KEY is blank.
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_API_ORIGIN=
TRUST_PROXY=false
# Explicit testnet funding amount, read only by infra/scripts/testnet-rewards.js fund.
FUND_MON=
